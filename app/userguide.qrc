<RCC version="1.0">
    <!-- The user guide (docs/user/), read in Help > User Guide. The
         resources mirror docs/: pages under /guide/user/, the images they
         use under /guide/images/, so the pages' relative links work as on
         GitHub. tools/checks/check_user_guide.py checks that every page and
         image is listed here, and nothing else. -->
    <qresource prefix="/guide">
        <file alias="user/README.md">../docs/user/README.md</file>
        <file alias="user/adding-wms-layers.md">../docs/user/adding-wms-layers.md</file>
        <file alias="user/adding-wmts-layers.md">../docs/user/adding-wmts-layers.md</file>
        <file alias="user/adding-xyz-layers.md">../docs/user/adding-xyz-layers.md</file>
        <file alias="user/adding-wfs-layers.md">../docs/user/adding-wfs-layers.md</file>
        <file alias="user/kml.md">../docs/user/kml.md</file>
        <file alias="user/getting-around.md">../docs/user/getting-around.md</file>
        <file alias="user/installation.md">../docs/user/installation.md</file>
        <file alias="user/layers.md">../docs/user/layers.md</file>
        <file alias="user/offline-use.md">../docs/user/offline-use.md</file>
        <file alias="user/terrain.md">../docs/user/terrain.md</file>
    </qresource>
</RCC>
