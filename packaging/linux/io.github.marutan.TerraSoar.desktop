[Desktop Entry]
Type=Application
Name=Terra Soar
GenericName=Globe and Map Viewer
Comment=View the Earth as a 3D globe or a 2D map, online and offline
Exec=terrasoar %F
Icon=io.github.marutan.TerraSoar
Terminal=false
Categories=Science;Geography;Geoscience;
Keywords=globe;map;GIS;WMS;WFS;KML;KMZ;terrain;elevation;earth;
MimeType=application/x-terrasoar-project;application/vnd.google-earth.kml+xml;application/vnd.google-earth.kmz;
StartupWMClass=terrasoar
